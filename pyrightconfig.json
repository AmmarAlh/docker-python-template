{
  "include": ["src", "tests"],
  "exclude": [
    "**/__pycache__",
    ".venv",
    "build",
    "dist", "**/node_modules", "**/.*"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "reportUnusedImport": true,
  "reportUnusedVariable": false
}